
# -------------------- 窗口设置 --------------------
window-save-state = never
window-width = 138
window-height = 36
window-padding-x = 10
window-padding-y = 10

# -------------------- 终端设置 --------------------
term = xterm-256color

# -------------------- 主题设置 --------------------
theme = "TokyoNight"
cursor-color = #FF8700

adjust-cursor-thickness=8

# -------------------- 字体设置 --------------------
font-family = "Maple Mono NF CN"
font-size = 13
font-thicken = true
bold-is-bright = true

# -------------------- 其他设置 --------------------
scrollback-limit = 10000
mouse-hide-while-typing = true

